{
  "name": "krunksketch",
  "version": "2.1.4",
  "description": "try to take over the world!",
  "author": "The Gaming Gurus",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node ./scripts/build.js",
    "watch": "node ./scripts/build.js --watch",
    "check": "tsc --noEmit",
    "build:dev": "node ./scripts/build.js --dev",
    "watch:dev": "node ./scripts/build.js --dev --watch",
    "update:loader": "node ./scripts/loader/update-loader.mjs && npm run build:dev",
    "verify:loader": "node ./scripts/loader/verify-loader.mjs",
    "verify:signature": "node ./scripts/loader/run-bundled.mjs verify-signature",
    "verify:derive": "node ./scripts/loader/run-bundled.mjs verify-derive"
  },
  "type": "module",
  "dependencies": {
    "brotli-dec-wasm": "^2.3.2",
    "jsonpack": "^1.1.5",
    "msgpackr": "^1.11.9",
    "path-browserify": "^1.0.1",
    "preact": "^10.26.4",
    "webcrack": "^2.16.0-beta.1"
  },
  "devDependencies": {
    "@fastify/send": "^4.0.0",
    "@types/jsonpack": "^1.1.6",
    "@types/node": "^22.13.14",
    "@types/tampermonkey": "^5.0.4",
    "@types/three": "^0.150.2",
    "dotenv-expand": "^12.0.1",
    "dotenv-flow": "^4.1.0",
    "esbuild": "^0.25.2",
    "javascript-obfuscator": "^4.1.1",
    "parseurl": "^1.3.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "userscript-metadata-generator": "^0.2.4"
  }
}
